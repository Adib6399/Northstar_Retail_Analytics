<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP006_ASIS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP006_ASIS">
    <bpmn:participant id="Participant_Process_BP006_ASIS" name="Northstar Retail Group — BP-006 AS-IS: Manual Customer Returns Handling" processRef="Process_BP006_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP006_ASIS" name="BP-006 AS-IS: Manual Customer Returns Handling" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Store_006A" name="Store Customer Service Desk &amp; Cashiers">
        <bpmn:flowNodeRef>Start_006A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_006A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006A_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006A_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006A_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_006A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_006A" name="Customer Arrives for Return">
      <bpmn:outgoing>Flow_006A_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_006A_1" name="Search Paper Bill in Local POS Terminal">
      <bpmn:incoming>Flow_006A_1</bpmn:incoming>
      <bpmn:outgoing>Flow_006A_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_006A_1" name="Cross-Store Bill / Invoice Missing?">
      <bpmn:incoming>Flow_006A_2</bpmn:incoming>
      <bpmn:outgoing>Flow_006A_3</bpmn:outgoing>
      <bpmn:outgoing>Flow_006A_4</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_006A_2" name="Store Manager Uses Key Override for Return">
      <bpmn:incoming>Flow_006A_3</bpmn:incoming>
      <bpmn:outgoing>Flow_006A_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_006A_3" name="Issue Handwritten Paper Credit Note Slip">
      <bpmn:incoming>Flow_006A_4</bpmn:incoming>
      <bpmn:incoming>Flow_006A_5</bpmn:incoming>
      <bpmn:outgoing>Flow_006A_6</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_006A_4" name="Bypass ERP Quarantine: Restock Defective Item">
      <bpmn:incoming>Flow_006A_6</bpmn:incoming>
      <bpmn:outgoing>Flow_006A_7</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_006A" name="Defective Goods Sold to New Customer">
      <bpmn:incoming>Flow_006A_7</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_006A_1" sourceRef="Start_006A" targetRef="Task_006A_1" />
    <bpmn:sequenceFlow id="Flow_006A_2" sourceRef="Task_006A_1" targetRef="Gateway_006A_1" />
    <bpmn:sequenceFlow id="Flow_006A_3" sourceRef="Gateway_006A_1" targetRef="Task_006A_2" name="Yes" />
    <bpmn:sequenceFlow id="Flow_006A_4" sourceRef="Gateway_006A_1" targetRef="Task_006A_3" name="No" />
    <bpmn:sequenceFlow id="Flow_006A_5" sourceRef="Task_006A_2" targetRef="Task_006A_3" />
    <bpmn:sequenceFlow id="Flow_006A_6" sourceRef="Task_006A_3" targetRef="Task_006A_4" />
    <bpmn:sequenceFlow id="Flow_006A_7" sourceRef="Task_006A_4" targetRef="End_006A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_BP006_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_BP006_ASIS" bpmnElement="Collaboration_Process_BP006_ASIS">
      <bpmndi:BPMNShape id="Participant_Process_BP006_ASIS_di" bpmnElement="Participant_Process_BP006_ASIS" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1380" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Store_006A_di" bpmnElement="Lane_Store_006A" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1350" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_006A_di" bpmnElement="Start_006A">
        <dc:Bounds x="200" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_006A_1_di" bpmnElement="Task_006A_1">
        <dc:Bounds x="280" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_006A_1_di" bpmnElement="Gateway_006A_1">
        <dc:Bounds x="420" y="233" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_006A_2_di" bpmnElement="Task_006A_2">
        <dc:Bounds x="520" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_006A_3_di" bpmnElement="Task_006A_3">
        <dc:Bounds x="660" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_006A_4_di" bpmnElement="Task_006A_4">
        <dc:Bounds x="800" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_006A_di" bpmnElement="End_006A">
        <dc:Bounds x="950" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_006A_1_di" bpmnElement="Flow_006A_1">
        <di:waypoint x="236" y="258" />
        <di:waypoint x="280" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_006A_2_di" bpmnElement="Flow_006A_2">
        <di:waypoint x="380" y="258" />
        <di:waypoint x="420" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_006A_3_di" bpmnElement="Flow_006A_3">
        <di:waypoint x="445" y="233" />
        <di:waypoint x="445" y="200" />
        <di:waypoint x="520" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_006A_4_di" bpmnElement="Flow_006A_4">
        <di:waypoint x="470" y="258" />
        <di:waypoint x="660" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_006A_5_di" bpmnElement="Flow_006A_5">
        <di:waypoint x="620" y="200" />
        <di:waypoint x="640" y="200" />
        <di:waypoint x="640" y="258" />
        <di:waypoint x="660" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_006A_6_di" bpmnElement="Flow_006A_6">
        <di:waypoint x="760" y="258" />
        <di:waypoint x="800" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_006A_7_di" bpmnElement="Flow_006A_7">
        <di:waypoint x="900" y="258" />
        <di:waypoint x="950" y="258" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>