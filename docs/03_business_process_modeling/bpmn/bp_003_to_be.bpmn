<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP003_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP003_TOBE">
    <bpmn:participant id="Participant_Process_BP003_TOBE" name="Northstar Retail Group — BP-003 TO-BE: Automated POS-Till Reconciliation &amp; Anomaly Detection" processRef="Process_BP003_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP003_TOBE" name="BP-003 TO-BE: Automated POS-Till Reconciliation &amp; Anomaly Detection" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Cashier_003B" name="Store Cashier &amp; Safe Deposit">
        <bpmn:flowNodeRef>Start_003B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_003B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_003B_2</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engine_003B" name="Reconciliation Platform &amp; Anomaly Engine">
        <bpmn:flowNodeRef>Task_003B_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_003B_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_003B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_003B_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_003B_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_StoreMgr_003B" name="Store Manager &amp; Audit Workbench">
        <bpmn:flowNodeRef>Task_003B_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_003B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_003B" name="Cashier Shift Close 21:30 IST">
      <bpmn:outgoing>Flow_003B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_003B_1" name="Enter Blind Cash Count on POS Screen">
      <bpmn:incoming>Flow_003B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_003B_2" name="Deposit Tamper-Evident Bag in Safe">
      <bpmn:incoming>Flow_003B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Task_003B_3" name="04:30 IST Engine Matches POS Lines vs. Tenders">
      <bpmn:incoming>Flow_003B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_003B_4" name="Compute Till Variance (Declared vs Expected)">
      <bpmn:incoming>Flow_003B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_003B_1" name="Variance &gt; PARAM_DISCREPANCY_THRESHOLD?">
      <bpmn:incoming>Flow_003B_5</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_003B_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_003B_5" name="Generate Automated Audit Investigation Ticket">
      <bpmn:incoming>Flow_003B_6</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_003B_6" name="Flag High Void Anomaly (&gt;5% Ratio)">
      <bpmn:incoming>Flow_003B_7</bpmn:incoming>
      <bpmn:incoming>Flow_003B_8</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_003B_7" name="Store Manager Reviews &amp; Submits Reason Code">
      <bpmn:incoming>Flow_003B_9</bpmn:incoming>
      <bpmn:outgoing>Flow_003B_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_003B" name="Audit Trail Committed by 06:00 IST">
      <bpmn:incoming>Flow_003B_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_003B_1" sourceRef="Start_003B" targetRef="Task_003B_1" />
    <bpmn:sequenceFlow id="Flow_003B_2" sourceRef="Task_003B_1" targetRef="Task_003B_2" />
    <bpmn:sequenceFlow id="Flow_003B_3" sourceRef="Task_003B_2" targetRef="Task_003B_3" />
    <bpmn:sequenceFlow id="Flow_003B_4" sourceRef="Task_003B_3" targetRef="Task_003B_4" />
    <bpmn:sequenceFlow id="Flow_003B_5" sourceRef="Task_003B_4" targetRef="Gateway_003B_1" />
    <bpmn:sequenceFlow id="Flow_003B_6" sourceRef="Gateway_003B_1" targetRef="Task_003B_5" name="Yes" />
    <bpmn:sequenceFlow id="Flow_003B_7" sourceRef="Gateway_003B_1" targetRef="Task_003B_6" name="No" />
    <bpmn:sequenceFlow id="Flow_003B_8" sourceRef="Task_003B_5" targetRef="Task_003B_6" />
    <bpmn:sequenceFlow id="Flow_003B_9" sourceRef="Task_003B_6" targetRef="Task_003B_7" />
    <bpmn:sequenceFlow id="Flow_003B_10" sourceRef="Task_003B_7" targetRef="End_003B" />
  </bpmn:process>
