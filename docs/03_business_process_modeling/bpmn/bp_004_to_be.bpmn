<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP004_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP004_TOBE">
    <bpmn:participant id="Participant_Process_BP004_TOBE" name="Northstar Retail Group — BP-004 TO-BE: Automated Three-Way Payment Settlement Reconciliation" processRef="Process_BP004_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP004_TOBE" name="BP-004 TO-BE: Automated Three-Way Payment Settlement Reconciliation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Engine_004B" name="Automated Financial Reconciliation Engine">
        <bpmn:flowNodeRef>Start_004B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004B_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004B_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_004B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004B_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004B_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Treasury_004B" name="Treasury &amp; Revenue Assurance">
        <bpmn:flowNodeRef>Task_004B_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_004B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_004B" name="Timer: 04:30 IST Daily">
      <bpmn:outgoing>Flow_004B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_004B_1" name="Ingest POS Tenders, Gateway Logs &amp; Bank Feeds">
      <bpmn:incoming>Flow_004B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_004B_2" name="Normalize Canonical UTR/RRN Identifiers">
      <bpmn:incoming>Flow_004B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_004B_3" name="Execute 3-Way Reconciliation Matching">
      <bpmn:incoming>Flow_004B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_004B_1" name="Variance &gt; PARAM_DISCREPANCY_THRESHOLD?">
      <bpmn:incoming>Flow_004B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_004B_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_004B_4" name="Generate Automated Treasury Audit Ticket">
      <bpmn:incoming>Flow_004B_5</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_004B_5" name="Verify MDR Contract Fee Deductions">
      <bpmn:incoming>Flow_004B_6</bpmn:incoming>
      <bpmn:incoming>Flow_004B_7</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_004B_6" name="Treasury Reviews 05:30 IST Settlement Workbench">
      <bpmn:incoming>Flow_004B_8</bpmn:incoming>
      <bpmn:outgoing>Flow_004B_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_004B" name="Daily Settlement Verified &amp; Audited">
      <bpmn:incoming>Flow_004B_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_004B_1" sourceRef="Start_004B" targetRef="Task_004B_1" />
    <bpmn:sequenceFlow id="Flow_004B_2" sourceRef="Task_004B_1" targetRef="Task_004B_2" />
    <bpmn:sequenceFlow id="Flow_004B_3" sourceRef="Task_004B_2" targetRef="Task_004B_3" />
    <bpmn:sequenceFlow id="Flow_004B_4" sourceRef="Task_004B_3" targetRef="Gateway_004B_1" />
    <bpmn:sequenceFlow id="Flow_004B_5" sourceRef="Gateway_004B_1" targetRef="Task_004B_4" name="Yes" />
    <bpmn:sequenceFlow id="Flow_004B_6" sourceRef="Gateway_004B_1" targetRef="Task_004B_5" name="No" />
    <bpmn:sequenceFlow id="Flow_004B_7" sourceRef="Task_004B_4" targetRef="Task_004B_5" />
    <bpmn:sequenceFlow id="Flow_004B_8" sourceRef="Task_004B_5" targetRef="Task_004B_6" />
    <bpmn:sequenceFlow id="Flow_004B_9" sourceRef="Task_004B_6" targetRef="End_004B" />
  </bpmn:process>
