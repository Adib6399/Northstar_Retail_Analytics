<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP007_ASIS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP007_ASIS">
    <bpmn:participant id="Participant_Process_BP007_ASIS" name="Northstar Retail Group — BP-007 AS-IS: Manual Marketing Attribution" processRef="Process_BP007_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP007_ASIS" name="BP-007 AS-IS: Manual Marketing Attribution" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Mkt_007A" name="Central Marketing &amp; Bulk SMS Agency">
        <bpmn:flowNodeRef>Start_007A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_007A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_007A_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_007A_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Store_007A" name="Store Checkout &amp; Executive Meeting">
        <bpmn:flowNodeRef>Task_007A_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_007A_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_007A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_007A" name="Upcoming Festive Campaign">
      <bpmn:outgoing>Flow_007A_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_007A_1" name="Extract Raw CRM Customer Phone Numbers to Excel">
      <bpmn:incoming>Flow_007A_1</bpmn:incoming>
      <bpmn:outgoing>Flow_007A_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:sendTask id="Task_007A_2" name="Email Unencrypted Phones to External SMS Vendor">
      <bpmn:incoming>Flow_007A_2</bpmn:incoming>
      <bpmn:outgoing>Flow_007A_3</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:serviceTask id="Task_007A_3" name="Vendor Blasts Unsegmented Mass SMS (No Holdout)">
      <bpmn:incoming>Flow_007A_3</bpmn:incoming>
      <bpmn:outgoing>Flow_007A_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_007A_4" name="Cashiers Apply Generic Discount Key at POS">
      <bpmn:incoming>Flow_007A_4</bpmn:incoming>
      <bpmn:outgoing>Flow_007A_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_007A_5" name="Marketing Attributes 100% Weekend Revenue in PPT">
      <bpmn:incoming>Flow_007A_5</bpmn:incoming>
      <bpmn:outgoing>Flow_007A_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_007A" name="CFO Rejects Inflated 800% ROMI Claims">
      <bpmn:incoming>Flow_007A_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_007A_1" sourceRef="Start_007A" targetRef="Task_007A_1" />
    <bpmn:sequenceFlow id="Flow_007A_2" sourceRef="Task_007A_1" targetRef="Task_007A_2" />
    <bpmn:sequenceFlow id="Flow_007A_3" sourceRef="Task_007A_2" targetRef="Task_007A_3" />
    <bpmn:sequenceFlow id="Flow_007A_4" sourceRef="Task_007A_3" targetRef="Task_007A_4" />
    <bpmn:sequenceFlow id="Flow_007A_5" sourceRef="Task_007A_4" targetRef="Task_007A_5" />
    <bpmn:sequenceFlow id="Flow_007A_6" sourceRef="Task_007A_5" targetRef="End_007A" />
  </bpmn:process>
