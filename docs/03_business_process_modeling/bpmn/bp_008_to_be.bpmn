  <bpmn:collaboration id="Collaboration_Process_BP008_TOBE">
    <bpmn:participant id="Participant_Process_BP008_TOBE" name="Northstar Retail Group — BP-008 TO-BE: Automated Statistical Forecasting &amp; Calendar Alignment" processRef="Process_BP008_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP008_TOBE" name="BP-008 TO-BE: Automated Statistical Forecasting &amp; Calendar Alignment" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Engine_008B" name="Analytics Platform Forecasting Engine">
        <bpmn:flowNodeRef>Start_008B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_008B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_008B_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_008B_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_008B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_008B_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Merch_008B" name="Category Merchandisers &amp; Procurement">
        <bpmn:flowNodeRef>Task_008B_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_008B_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_008B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_008B" name="Timer: 05:00 IST Daily">
      <bpmn:outgoing>Flow_008B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_008B_1" name="Ingest Sales History &amp; Enriched Calendar Index">
      <bpmn:incoming>Flow_008B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_008B_2" name="Align Shifting Regional Lunar Festivals">
      <bpmn:incoming>Flow_008B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_008B_3" name="Execute Holt-Winters &amp; Auto-ARIMA BDL-07">
      <bpmn:incoming>Flow_008B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_4</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_008B_1" name="SKU Forecast MAPE &lt; 18%?">
      <bpmn:incoming>Flow_008B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_008B_4" name="Calculate Net PO Advisory factoring MOQ &amp; Lead Time">
      <bpmn:incoming>Flow_008B_5</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_008B_5" name="Merchandiser Confirms Quantities in Workbench">
      <bpmn:incoming>Flow_008B_6</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_008B_6" name="Export Structured PO Batch to Native ERP BDL-04">
      <bpmn:incoming>Flow_008B_7</bpmn:incoming>
      <bpmn:outgoing>Flow_008B_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_008B" name="Optimized Supplier Procurement Executed">
      <bpmn:incoming>Flow_008B_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_008B_1" sourceRef="Start_008B" targetRef="Task_008B_1" />
    <bpmn:sequenceFlow id="Flow_008B_2" sourceRef="Task_008B_1" targetRef="Task_008B_2" />
    <bpmn:sequenceFlow id="Flow_008B_3" sourceRef="Task_008B_2" targetRef="Task_008B_3" />
    <bpmn:sequenceFlow id="Flow_008B_4" sourceRef="Task_008B_3" targetRef="Gateway_008B_1" />
    <bpmn:sequenceFlow id="Flow_008B_5" sourceRef="Gateway_008B_1" targetRef="Task_008B_4" name="Certified" />
    <bpmn:sequenceFlow id="Flow_008B_6" sourceRef="Task_008B_4" targetRef="Task_008B_5" />
    <bpmn:sequenceFlow id="Flow_008B_7" sourceRef="Task_008B_5" targetRef="Task_008B_6" />
    <bpmn:sequenceFlow id="Flow_008B_8" sourceRef="Task_008B_6" targetRef="End_008B" />
  </bpmn:process>
