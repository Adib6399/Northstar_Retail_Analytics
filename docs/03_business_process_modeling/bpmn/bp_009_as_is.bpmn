        <bpmn:flowNodeRef>Task_009A_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_009A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_009A" name="Friday: Prep for Executive Review">
      <bpmn:outgoing>Flow_009A_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_009A_1" name="Finance, Ops &amp; Mkt Pull Conflicting CSVs">
      <bpmn:incoming>Flow_009A_1</bpmn:incoming>
      <bpmn:outgoing>Flow_009A_2</bpmn:outgoing>
    </bpmn:userTask>
