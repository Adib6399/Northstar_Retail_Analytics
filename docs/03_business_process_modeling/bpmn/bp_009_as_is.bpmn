      <bpmn:incoming>Flow_009A_2</bpmn:incoming>
      <bpmn:outgoing>Flow_009A_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_009A_3" name="Compile PowerPoint Decks on Sunday Night">
      <bpmn:incoming>Flow_009A_3</bpmn:incoming>
      <bpmn:outgoing>Flow_009A_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_009A_4" name="Monday 10:00 IST Executive Review Commences">
      <bpmn:incoming>Flow_009A_4</bpmn:incoming>
      <bpmn:outgoing>Flow_009A_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_009A_1" name="Do Department Numbers Match?">
      <bpmn:incoming>Flow_009A_5</bpmn:incoming>
      <bpmn:outgoing>Flow_009A_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_009A_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_009A_5" name="Heated Debate &amp; Task Analysts with Audit">
      <bpmn:incoming>Flow_009A_6</bpmn:incoming>
      <bpmn:outgoing>Flow_009A_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_009A" name="Delayed Strategy &amp; Masked Mall Unprofitability">
      <bpmn:incoming>Flow_009A_7</bpmn:incoming>
      <bpmn:incoming>Flow_009A_8</bpmn:incoming>
    </bpmn:endEvent>
