  </bpmn:collaboration>
  <bpmn:process id="Process_BP009_ASIS" name="BP-009 AS-IS: Fragmented Executive Reporting" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Depts_009A" name="Departmental Financial Analysts">
        <bpmn:flowNodeRef>Start_009A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_009A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_009A_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_009A_3</bpmn:flowNodeRef>
