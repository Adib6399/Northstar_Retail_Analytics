<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP005_ASIS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP005_ASIS">
    <bpmn:participant id="Participant_Process_BP005_ASIS" name="Northstar Retail Group — BP-005 AS-IS: Manual POS-ERP Stock Audit" processRef="Process_BP005_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP005_ASIS" name="BP-005 AS-IS: Manual POS-ERP Stock Audit" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Store_005A" name="Store Inventory Controllers">
        <bpmn:flowNodeRef>Start_005A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005A_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005A_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Audit_005A" name="Quarterly External Stock Auditors">
        <bpmn:flowNodeRef>Task_005A_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005A_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_005A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_005A" name="Daily POS Scans at Checkout">
      <bpmn:outgoing>Flow_005A_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_005A_1" name="Unmonitored Nightly ERP Decrement Batch">
      <bpmn:incoming>Flow_005A_1</bpmn:incoming>
      <bpmn:outgoing>Flow_005A_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:manualTask id="Task_005A_2" name="Sync Drops Fail Silently: Drift Compounds">
      <bpmn:incoming>Flow_005A_2</bpmn:incoming>
      <bpmn:outgoing>Flow_005A_3</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_005A_3" name="Phantom Stock Accumulates in Stores">
      <bpmn:incoming>Flow_005A_3</bpmn:incoming>
      <bpmn:outgoing>Flow_005A_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:manualTask id="Task_005A_4" name="Exhausting Quarterly Physical Wall Count">
      <bpmn:incoming>Flow_005A_4</bpmn:incoming>
      <bpmn:outgoing>Flow_005A_5</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_005A_5" name="Weeks of Excel Matching &amp; Massive P&amp;L Write-Off">
      <bpmn:incoming>Flow_005A_5</bpmn:incoming>
      <bpmn:outgoing>Flow_005A_6</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_005A" name="₹1.2Cr+ Annual Retail Shrinkage Written Off">
      <bpmn:incoming>Flow_005A_6</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_005A_1" sourceRef="Start_005A" targetRef="Task_005A_1" />
    <bpmn:sequenceFlow id="Flow_005A_2" sourceRef="Task_005A_1" targetRef="Task_005A_2" />
    <bpmn:sequenceFlow id="Flow_005A_3" sourceRef="Task_005A_2" targetRef="Task_005A_3" />
    <bpmn:sequenceFlow id="Flow_005A_4" sourceRef="Task_005A_3" targetRef="Task_005A_4" />
    <bpmn:sequenceFlow id="Flow_005A_5" sourceRef="Task_005A_4" targetRef="Task_005A_5" />
    <bpmn:sequenceFlow id="Flow_005A_6" sourceRef="Task_005A_5" targetRef="End_005A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_BP005_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_BP005_ASIS" bpmnElement="Collaboration_Process_BP005_ASIS">
      <bpmndi:BPMNShape id="Participant_Process_BP005_ASIS_di" bpmnElement="Participant_Process_BP005_ASIS" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1380" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Store_005A_di" bpmnElement="Lane_Store_005A" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1350" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Audit_005A_di" bpmnElement="Lane_Audit_005A" isHorizontal="true">
        <dc:Bounds x="150" y="320" width="1350" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_005A_di" bpmnElement="Start_005A">
        <dc:Bounds x="200" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_005A_1_di" bpmnElement="Task_005A_1">
        <dc:Bounds x="280" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_005A_2_di" bpmnElement="Task_005A_2">
