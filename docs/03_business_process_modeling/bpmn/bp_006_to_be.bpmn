<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP006_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP006_TOBE">
    <bpmn:participant id="Participant_Process_BP006_TOBE" name="Northstar Retail Group — BP-006 TO-BE: Automated Cross-Store Returns &amp; Quarantine Matching" processRef="Process_BP006_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP006_TOBE" name="BP-006 TO-BE: Automated Cross-Store Returns &amp; Quarantine Matching" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Store_006B" name="Customer Service &amp; Quarantine Receiving">
        <bpmn:flowNodeRef>Start_006B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006B_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006B_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Engine_006B" name="Returns Reconciliation &amp; Fraud Surveillance">
        <bpmn:flowNodeRef>Task_006B_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_006B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006B_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_006B_6</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_LP_006B" name="Loss Prevention &amp; Store Audit">
        <bpmn:flowNodeRef>Task_006B_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_006B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_006B" name="Customer Presents Return at Desk">
      <bpmn:outgoing>Flow_006B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_006B_1" name="Central Invoice Search &amp; Reason Code Entry">
      <bpmn:incoming>Flow_006B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_006B_2" name="Issue Digital Credit Note &amp; Print QR Label">
      <bpmn:incoming>Flow_006B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_006B_3" name="Scan Item into ERP Quarantine GRN Mvt 451">
      <bpmn:incoming>Flow_006B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_4</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:serviceTask id="Task_006B_4" name="04:30 IST Engine Matches POS Credit vs ERP GRN">
      <bpmn:incoming>Flow_006B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_5</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_006B_1" name="Unreferenced Return &gt; ₹1,000?">
      <bpmn:incoming>Flow_006B_5</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_006B_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_006B_5" name="Generate Return Fraud Investigation Ticket">
      <bpmn:incoming>Flow_006B_6</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_006B_6" name="Publish 05:30 IST Returns Audit Workbench">
      <bpmn:incoming>Flow_006B_7</bpmn:incoming>
      <bpmn:incoming>Flow_006B_8</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_006B_7" name="Loss Prevention Reviews High-Risk Overrides">
      <bpmn:incoming>Flow_006B_9</bpmn:incoming>
      <bpmn:outgoing>Flow_006B_10</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_006B" name="Returned Inventory Governed &amp; Verified">
      <bpmn:incoming>Flow_006B_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_006B_1" sourceRef="Start_006B" targetRef="Task_006B_1" />
    <bpmn:sequenceFlow id="Flow_006B_2" sourceRef="Task_006B_1" targetRef="Task_006B_2" />
    <bpmn:sequenceFlow id="Flow_006B_3" sourceRef="Task_006B_2" targetRef="Task_006B_3" />
    <bpmn:sequenceFlow id="Flow_006B_4" sourceRef="Task_006B_3" targetRef="Task_006B_4" />
    <bpmn:sequenceFlow id="Flow_006B_5" sourceRef="Task_006B_4" targetRef="Gateway_006B_1" />
    <bpmn:sequenceFlow id="Flow_006B_6" sourceRef="Gateway_006B_1" targetRef="Task_006B_5" name="Yes" />
    <bpmn:sequenceFlow id="Flow_006B_7" sourceRef="Gateway_006B_1" targetRef="Task_006B_6" name="No" />
    <bpmn:sequenceFlow id="Flow_006B_8" sourceRef="Task_006B_5" targetRef="Task_006B_6" />
    <bpmn:sequenceFlow id="Flow_006B_9" sourceRef="Task_006B_6" targetRef="Task_006B_7" />
    <bpmn:sequenceFlow id="Flow_006B_10" sourceRef="Task_006B_7" targetRef="End_006B" />
  </bpmn:process>
