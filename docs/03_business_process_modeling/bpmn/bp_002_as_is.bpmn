<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP002_ASIS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP002_ASIS">
    <bpmn:participant id="Participant_Process_BP002_ASIS" name="Northstar Retail Group — BP-002 AS-IS: Manual Store Replenishment &amp; DC Allocation" processRef="Process_BP002_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP002_ASIS" name="BP-002 AS-IS: Manual Store Replenishment &amp; DC Allocation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Store_002A" name="Store Floor Staff &amp; Store Manager">
        <bpmn:flowNodeRef>Start_002A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002A_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002A_3</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_DC_002A" name="Central DC Inventory Planners">
        <bpmn:flowNodeRef>Task_002A_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_002A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002A_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002A_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_002A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_002A" name="Visual Out-of-Stock Detected">
      <bpmn:outgoing>Flow_002A_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:manualTask id="Task_002A_1" name="Floor Staff Audits Shelf with Clipboard">
      <bpmn:incoming>Flow_002A_1</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_2</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:userTask id="Task_002A_2" name="Store Clerk Looks Up Phantom Stock in ERP">
      <bpmn:incoming>Flow_002A_2</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_002A_3" name="Store Manager Submits Subjective ERP Indent">
      <bpmn:incoming>Flow_002A_3</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_002A_4" name="DC Planners Ingest 30 Indents into Excel">
      <bpmn:incoming>Flow_002A_4</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_5</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_002A_1" name="DC Stock Sufficient for All Stores?">
      <bpmn:incoming>Flow_002A_5</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_6</bpmn:outgoing>
      <bpmn:outgoing>Flow_002A_7</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_002A_5" name="DC Planner Arbitrarily Cuts Store Orders">
      <bpmn:incoming>Flow_002A_6</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:manualTask id="Task_002A_6" name="Warehouse Picking &amp; Multi-Stop Truck Dispatch">
      <bpmn:incoming>Flow_002A_7</bpmn:incoming>
      <bpmn:incoming>Flow_002A_8</bpmn:incoming>
      <bpmn:outgoing>Flow_002A_9</bpmn:outgoing>
    </bpmn:manualTask>
    <bpmn:endEvent id="End_002A" name="Delayed Store Delivery (T+2 to T+4 Days)">
      <bpmn:incoming>Flow_002A_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_002A_1" sourceRef="Start_002A" targetRef="Task_002A_1" />
    <bpmn:sequenceFlow id="Flow_002A_2" sourceRef="Task_002A_1" targetRef="Task_002A_2" />
    <bpmn:sequenceFlow id="Flow_002A_3" sourceRef="Task_002A_2" targetRef="Task_002A_3" />
    <bpmn:sequenceFlow id="Flow_002A_4" sourceRef="Task_002A_3" targetRef="Task_002A_4" />
    <bpmn:sequenceFlow id="Flow_002A_5" sourceRef="Task_002A_4" targetRef="Gateway_002A_1" />
    <bpmn:sequenceFlow id="Flow_002A_6" sourceRef="Gateway_002A_1" targetRef="Task_002A_5" name="No" />
    <bpmn:sequenceFlow id="Flow_002A_7" sourceRef="Gateway_002A_1" targetRef="Task_002A_6" name="Yes" />
    <bpmn:sequenceFlow id="Flow_002A_8" sourceRef="Task_002A_5" targetRef="Task_002A_6" />
    <bpmn:sequenceFlow id="Flow_002A_9" sourceRef="Task_002A_6" targetRef="End_002A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_BP002_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_BP002_ASIS" bpmnElement="Collaboration_Process_BP002_ASIS">
      <bpmndi:BPMNShape id="Participant_Process_BP002_ASIS_di" bpmnElement="Participant_Process_BP002_ASIS" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1380" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Store_002A_di" bpmnElement="Lane_Store_002A" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1350" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_DC_002A_di" bpmnElement="Lane_DC_002A" isHorizontal="true">
        <dc:Bounds x="150" y="320" width="1350" height="240" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_002A_di" bpmnElement="Start_002A">
        <dc:Bounds x="200" y="160" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_002A_1_di" bpmnElement="Task_002A_1">
        <dc:Bounds x="280" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_002A_2_di" bpmnElement="Task_002A_2">
        <dc:Bounds x="420" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_002A_3_di" bpmnElement="Task_002A_3">
        <dc:Bounds x="560" y="138" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_002A_4_di" bpmnElement="Task_002A_4">
        <dc:Bounds x="700" y="378" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_002A_1_di" bpmnElement="Gateway_002A_1">
        <dc:Bounds x="850" y="393" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_002A_5_di" bpmnElement="Task_002A_5">
        <dc:Bounds x="950" y="330" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_002A_6_di" bpmnElement="Task_002A_6">
        <dc:Bounds x="1100" y="378" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_002A_di" bpmnElement="End_002A">
        <dc:Bounds x="1260" y="400" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_002A_1_di" bpmnElement="Flow_002A_1">
        <di:waypoint x="236" y="178" />
        <di:waypoint x="280" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_2_di" bpmnElement="Flow_002A_2">
        <di:waypoint x="380" y="178" />
        <di:waypoint x="420" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_3_di" bpmnElement="Flow_002A_3">
        <di:waypoint x="520" y="178" />
        <di:waypoint x="560" y="178" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_4_di" bpmnElement="Flow_002A_4">
        <di:waypoint x="660" y="178" />
        <di:waypoint x="680" y="178" />
        <di:waypoint x="680" y="418" />
        <di:waypoint x="700" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_5_di" bpmnElement="Flow_002A_5">
        <di:waypoint x="800" y="418" />
        <di:waypoint x="850" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_6_di" bpmnElement="Flow_002A_6">
        <di:waypoint x="875" y="393" />
        <di:waypoint x="875" y="370" />
        <di:waypoint x="950" y="370" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_7_di" bpmnElement="Flow_002A_7">
        <di:waypoint x="900" y="418" />
        <di:waypoint x="1100" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_8_di" bpmnElement="Flow_002A_8">
        <di:waypoint x="1050" y="370" />
        <di:waypoint x="1075" y="370" />
        <di:waypoint x="1075" y="418" />
        <di:waypoint x="1100" y="418" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_002A_9_di" bpmnElement="Flow_002A_9">
        <di:waypoint x="1200" y="418" />
        <di:waypoint x="1260" y="418" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
</bpmn:definitions>