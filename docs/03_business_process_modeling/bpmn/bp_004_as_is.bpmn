        <di:waypoint x="725" y="320" />
        <di:waypoint x="800" y="320" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_7_di" bpmnElement="Flow_004A_7">
        <di:waypoint x="900" y="200" />
        <di:waypoint x="960" y="200" />
        <di:waypoint x="960" y="258" />
        <di:waypoint x="1020" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_8_di" bpmnElement="Flow_004A_8">
        <di:waypoint x="900" y="320" />
        <di:waypoint x="960" y="320" />
        <di:waypoint x="960" y="258" />
        <di:waypoint x="1020" y="258" />
      </bpmndi:BPMNEdge>
    </bpmndi:BPMNPlane>
  </bpmndi:BPMNDiagram>
