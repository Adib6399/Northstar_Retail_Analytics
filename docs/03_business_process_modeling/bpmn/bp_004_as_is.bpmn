<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP004_ASIS" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP004_ASIS">
    <bpmn:participant id="Participant_Process_BP004_ASIS" name="Northstar Retail Group — BP-004 AS-IS: Manual Payment Settlement Reconciliation" processRef="Process_BP004_ASIS" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP004_ASIS" name="BP-004 AS-IS: Manual Payment Settlement Reconciliation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Treasury_004A" name="Corporate Treasury Analysts">
        <bpmn:flowNodeRef>Start_004A</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004A_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004A_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_004A_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004A_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_004A_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_004A</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_004A" name="Month-End Close (T+10 Days)">
      <bpmn:outgoing>Flow_004A_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:userTask id="Task_004A_1" name="Manually Log into 4 Merchant Portals">
      <bpmn:incoming>Flow_004A_1</bpmn:incoming>
      <bpmn:outgoing>Flow_004A_2</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_004A_2" name="Download CSV Files &amp; Bank PDF Statements">
      <bpmn:incoming>Flow_004A_2</bpmn:incoming>
      <bpmn:outgoing>Flow_004A_3</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_004A_3" name="Execute Excel VLOOKUP on Reference Numbers">
      <bpmn:incoming>Flow_004A_3</bpmn:incoming>
      <bpmn:outgoing>Flow_004A_4</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:exclusiveGateway id="Gateway_004A_1" name="Reference Matched Cleanly?">
      <bpmn:incoming>Flow_004A_4</bpmn:incoming>
      <bpmn:outgoing>Flow_004A_5</bpmn:outgoing>
      <bpmn:outgoing>Flow_004A_6</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:userTask id="Task_004A_4" name="Park Unmatched Funds in Suspense Account">
      <bpmn:incoming>Flow_004A_5</bpmn:incoming>
      <bpmn:outgoing>Flow_004A_7</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:userTask id="Task_004A_5" name="Mark Settled &amp; Accept Deducted Fees">
      <bpmn:incoming>Flow_004A_6</bpmn:incoming>
      <bpmn:outgoing>Flow_004A_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:endEvent id="End_004A" name="Reconciliation Closes T+20 Days Post-Month">
      <bpmn:incoming>Flow_004A_7</bpmn:incoming>
      <bpmn:incoming>Flow_004A_8</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_004A_1" sourceRef="Start_004A" targetRef="Task_004A_1" />
    <bpmn:sequenceFlow id="Flow_004A_2" sourceRef="Task_004A_1" targetRef="Task_004A_2" />
    <bpmn:sequenceFlow id="Flow_004A_3" sourceRef="Task_004A_2" targetRef="Task_004A_3" />
    <bpmn:sequenceFlow id="Flow_004A_4" sourceRef="Task_004A_3" targetRef="Gateway_004A_1" />
    <bpmn:sequenceFlow id="Flow_004A_5" sourceRef="Gateway_004A_1" targetRef="Task_004A_4" name="No" />
    <bpmn:sequenceFlow id="Flow_004A_6" sourceRef="Gateway_004A_1" targetRef="Task_004A_5" name="Yes" />
    <bpmn:sequenceFlow id="Flow_004A_7" sourceRef="Task_004A_4" targetRef="End_004A" />
    <bpmn:sequenceFlow id="Flow_004A_8" sourceRef="Task_004A_5" targetRef="End_004A" />
  </bpmn:process>
  <bpmndi:BPMNDiagram id="BPMNDiagram_Process_BP004_ASIS">
    <bpmndi:BPMNPlane id="BPMNPlane_Process_BP004_ASIS" bpmnElement="Collaboration_Process_BP004_ASIS">
      <bpmndi:BPMNShape id="Participant_Process_BP004_ASIS_di" bpmnElement="Participant_Process_BP004_ASIS" isHorizontal="true">
        <dc:Bounds x="120" y="80" width="1380" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Lane_Treasury_004A_di" bpmnElement="Lane_Treasury_004A" isHorizontal="true">
        <dc:Bounds x="150" y="80" width="1350" height="480" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Start_004A_di" bpmnElement="Start_004A">
        <dc:Bounds x="200" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_004A_1_di" bpmnElement="Task_004A_1">
        <dc:Bounds x="280" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_004A_2_di" bpmnElement="Task_004A_2">
        <dc:Bounds x="420" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_004A_3_di" bpmnElement="Task_004A_3">
        <dc:Bounds x="560" y="218" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Gateway_004A_1_di" bpmnElement="Gateway_004A_1">
        <dc:Bounds x="700" y="233" width="50" height="50" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_004A_4_di" bpmnElement="Task_004A_4">
        <dc:Bounds x="800" y="160" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="Task_004A_5_di" bpmnElement="Task_004A_5">
        <dc:Bounds x="800" y="280" width="100" height="80" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNShape id="End_004A_di" bpmnElement="End_004A">
        <dc:Bounds x="1020" y="240" width="36" height="36" />
      </bpmndi:BPMNShape>
      <bpmndi:BPMNEdge id="Flow_004A_1_di" bpmnElement="Flow_004A_1">
        <di:waypoint x="236" y="258" />
        <di:waypoint x="280" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_2_di" bpmnElement="Flow_004A_2">
        <di:waypoint x="380" y="258" />
        <di:waypoint x="420" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_3_di" bpmnElement="Flow_004A_3">
        <di:waypoint x="520" y="258" />
        <di:waypoint x="560" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_4_di" bpmnElement="Flow_004A_4">
        <di:waypoint x="660" y="258" />
        <di:waypoint x="700" y="258" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_5_di" bpmnElement="Flow_004A_5">
        <di:waypoint x="725" y="233" />
        <di:waypoint x="725" y="200" />
        <di:waypoint x="800" y="200" />
      </bpmndi:BPMNEdge>
      <bpmndi:BPMNEdge id="Flow_004A_6_di" bpmnElement="Flow_004A_6">
