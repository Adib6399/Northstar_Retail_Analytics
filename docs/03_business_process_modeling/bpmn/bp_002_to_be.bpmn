  <bpmn:collaboration id="Collaboration_Process_BP002_TOBE">
    <bpmn:participant id="Participant_Process_BP002_TOBE" name="Northstar Retail Group — BP-002 TO-BE: Automated Dynamic DOI &amp; Replenishment Advisory" processRef="Process_BP002_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP002_TOBE" name="BP-002 TO-BE: Automated Dynamic DOI &amp; Replenishment Advisory" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Engine_002B" name="Analytics Platform Replenishment Engine">
        <bpmn:flowNodeRef>Start_002B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002B_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_002B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002B_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002B_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002B_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Ops_002B" name="Store Managers &amp; DC Operations">
        <bpmn:flowNodeRef>Task_002B_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_002B_7</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_002B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_002B" name="Timer: 04:45 IST Daily">
      <bpmn:outgoing>Flow_002B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_002B_1" name="Ingest ERP Midnight Stock &amp; POS Velocity">
      <bpmn:incoming>Flow_002B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_002B_2" name="Calculate Dynamic DOI &amp; ABC Stratification">
      <bpmn:incoming>Flow_002B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_002B_1" name="Class-A SKU DOI &lt; 3.0 Days?">
      <bpmn:incoming>Flow_002B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_002B_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_002B_3" name="Generate High-Priority Stockout Risk Flag">
      <bpmn:incoming>Flow_002B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_002B_4" name="Algorithmic Replenishment Sizing &amp; Allocation">
      <bpmn:incoming>Flow_002B_5</bpmn:incoming>
      <bpmn:incoming>Flow_002B_6</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_002B_5" name="Publish 06:00 IST Morning Inventory Workbench">
      <bpmn:incoming>Flow_002B_7</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_002B_6" name="Store Manager Reviews &amp; Confirms Reorder Lines">
      <bpmn:incoming>Flow_002B_8</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_9</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_002B_7" name="Export Structured STO Batch File to Native ERP BDL-04">
      <bpmn:incoming>Flow_002B_9</bpmn:incoming>
      <bpmn:outgoing>Flow_002B_10</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_002B" name="Optimized DC Stock Allocation Released">
      <bpmn:incoming>Flow_002B_10</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_002B_1" sourceRef="Start_002B" targetRef="Task_002B_1" />
    <bpmn:sequenceFlow id="Flow_002B_2" sourceRef="Task_002B_1" targetRef="Task_002B_2" />
    <bpmn:sequenceFlow id="Flow_002B_3" sourceRef="Task_002B_2" targetRef="Gateway_002B_1" />
    <bpmn:sequenceFlow id="Flow_002B_4" sourceRef="Gateway_002B_1" targetRef="Task_002B_3" name="Yes" />
    <bpmn:sequenceFlow id="Flow_002B_5" sourceRef="Gateway_002B_1" targetRef="Task_002B_4" name="No" />
    <bpmn:sequenceFlow id="Flow_002B_6" sourceRef="Task_002B_3" targetRef="Task_002B_4" />
    <bpmn:sequenceFlow id="Flow_002B_7" sourceRef="Task_002B_4" targetRef="Task_002B_5" />
    <bpmn:sequenceFlow id="Flow_002B_8" sourceRef="Task_002B_5" targetRef="Task_002B_6" />
    <bpmn:sequenceFlow id="Flow_002B_9" sourceRef="Task_002B_6" targetRef="Task_002B_7" />
    <bpmn:sequenceFlow id="Flow_002B_10" sourceRef="Task_002B_7" targetRef="End_002B" />
  </bpmn:process>
