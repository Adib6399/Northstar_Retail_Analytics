<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP005_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP005_TOBE">
    <bpmn:participant id="Participant_Process_BP005_TOBE" name="Northstar Retail Group — BP-005 TO-BE: Automated POS-ERP Inventory Reconciliation" processRef="Process_BP005_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP005_TOBE" name="BP-005 TO-BE: Automated POS-ERP Inventory Reconciliation" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Engine_005B" name="Analytics Platform Inventory Engine">
        <bpmn:flowNodeRef>Start_005B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005B_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_005B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005B_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005B_4</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Store_005B" name="Store Inventory Supervisors &amp; ERP Native Entry">
        <bpmn:flowNodeRef>Task_005B_5</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_005B_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_005B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_005B" name="Timer: 04:30 IST Daily">
      <bpmn:outgoing>Flow_005B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_005B_1" name="Ingest POS Scanned Lines &amp; ERP Mvt 251 Ledger">
      <bpmn:incoming>Flow_005B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_005B_2" name="Compute SKU-Level Unit and Valuation Delta">
      <bpmn:incoming>Flow_005B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_005B_1" name="Delta &gt; PARAM_DISCREPANCY_THRESHOLD?">
      <bpmn:incoming>Flow_005B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_005B_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_005B_3" name="Generate Automated Inventory Discrepancy Ticket">
      <bpmn:incoming>Flow_005B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_005B_4" name="Publish 05:30 IST Morning Inventory View">
      <bpmn:incoming>Flow_005B_5</bpmn:incoming>
      <bpmn:incoming>Flow_005B_6</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:userTask id="Task_005B_5" name="Supervisor Performs 15-Min Targeted Cycle Count">
      <bpmn:incoming>Flow_005B_7</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_8</bpmn:outgoing>
    </bpmn:userTask>
    <bpmn:serviceTask id="Task_005B_6" name="Export Validated Cycle Count to Native ERP Batch BDL-04">
      <bpmn:incoming>Flow_005B_8</bpmn:incoming>
      <bpmn:outgoing>Flow_005B_9</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:endEvent id="End_005B" name="ERP Records Synchronized without Direct Write">
      <bpmn:incoming>Flow_005B_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_005B_1" sourceRef="Start_005B" targetRef="Task_005B_1" />
    <bpmn:sequenceFlow id="Flow_005B_2" sourceRef="Task_005B_1" targetRef="Task_005B_2" />
    <bpmn:sequenceFlow id="Flow_005B_3" sourceRef="Task_005B_2" targetRef="Gateway_005B_1" />
    <bpmn:sequenceFlow id="Flow_005B_4" sourceRef="Gateway_005B_1" targetRef="Task_005B_3" name="Yes" />
    <bpmn:sequenceFlow id="Flow_005B_5" sourceRef="Gateway_005B_1" targetRef="Task_005B_4" name="No" />
    <bpmn:sequenceFlow id="Flow_005B_6" sourceRef="Task_005B_3" targetRef="Task_005B_4" />
    <bpmn:sequenceFlow id="Flow_005B_7" sourceRef="Task_005B_4" targetRef="Task_005B_5" />
    <bpmn:sequenceFlow id="Flow_005B_8" sourceRef="Task_005B_5" targetRef="Task_005B_6" />
    <bpmn:sequenceFlow id="Flow_005B_9" sourceRef="Task_005B_6" targetRef="End_005B" />
  </bpmn:process>
