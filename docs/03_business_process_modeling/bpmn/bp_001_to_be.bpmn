<?xml version="1.0" encoding="UTF-8"?>
<bpmn:definitions xmlns:bpmn="http://www.omg.org/spec/BPMN/20100524/MODEL" xmlns:bpmndi="http://www.omg.org/spec/BPMN/20100524/DI" xmlns:dc="http://www.omg.org/spec/DD/20100524/DC" xmlns:di="http://www.omg.org/spec/DD/20100524/DI" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" id="Definitions_Process_BP001_TOBE" targetNamespace="http://bpmn.io/schema/bpmn" exporter="Northstar Process Architect" exporterVersion="2.0">
  <bpmn:collaboration id="Collaboration_Process_BP001_TOBE">
    <bpmn:participant id="Participant_Process_BP001_TOBE" name="Northstar Retail Group — BP-001 TO-BE: Automated Daily Sales Ingestion &amp; Publishing" processRef="Process_BP001_TOBE" />
  </bpmn:collaboration>
  <bpmn:process id="Process_BP001_TOBE" name="BP-001 TO-BE: Automated Daily Sales Ingestion &amp; Publishing" isExecutable="false">
    <bpmn:laneSet id="LaneSet_1">
      <bpmn:lane id="Lane_Store_TOBE" name="Store Edge POS Server">
        <bpmn:flowNodeRef>Start_001B</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_001B_1</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Cloud_TOBE" name="Analytics Platform Orchestrator">
        <bpmn:flowNodeRef>Task_001B_2</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Gateway_001B_1</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_001B_3</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_001B_4</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>Task_001B_5</bpmn:flowNodeRef>
      </bpmn:lane>
      <bpmn:lane id="Lane_Exec_TOBE" name="Store Managers &amp; Executive Leadership">
        <bpmn:flowNodeRef>Task_001B_6</bpmn:flowNodeRef>
        <bpmn:flowNodeRef>End_001B</bpmn:flowNodeRef>
      </bpmn:lane>
    </bpmn:laneSet>
    <bpmn:startEvent id="Start_001B" name="Timer: 01:00 IST Off-Peak Batch">
      <bpmn:outgoing>Flow_001B_1</bpmn:outgoing>
    </bpmn:startEvent>
    <bpmn:serviceTask id="Task_001B_1" name="Store Edge Agent Extracts &amp; Compresses 5MB Chunks">
      <bpmn:incoming>Flow_001B_1</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_2</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_001B_2" name="Cloud Staging Ingests 30 Store Batches">
      <bpmn:incoming>Flow_001B_2</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_3</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:exclusiveGateway id="Gateway_001B_1" name="All Stores Ingested by 04:30 IST?">
      <bpmn:incoming>Flow_001B_3</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_4</bpmn:outgoing>
      <bpmn:outgoing>Flow_001B_5</bpmn:outgoing>
    </bpmn:exclusiveGateway>
    <bpmn:serviceTask id="Task_001B_3" name="Tag Partial Data Banner &amp; Alert Support">
      <bpmn:incoming>Flow_001B_4</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_6</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_001B_4" name="DQ Validation &amp; Exception Quarantine">
      <bpmn:incoming>Flow_001B_5</bpmn:incoming>
      <bpmn:incoming>Flow_001B_6</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_7</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:serviceTask id="Task_001B_5" name="Semantic KPI Aggregation &amp; DSR Generation">
      <bpmn:incoming>Flow_001B_7</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_8</bpmn:outgoing>
    </bpmn:serviceTask>
    <bpmn:sendTask id="Task_001B_6" name="06:00 IST Automated Email Push &amp; Mobile Workbench">
      <bpmn:incoming>Flow_001B_8</bpmn:incoming>
      <bpmn:outgoing>Flow_001B_9</bpmn:outgoing>
    </bpmn:sendTask>
    <bpmn:endEvent id="End_001B" name="06:30 IST Executive Cockpit Live">
      <bpmn:incoming>Flow_001B_9</bpmn:incoming>
    </bpmn:endEvent>
    <bpmn:sequenceFlow id="Flow_001B_1" sourceRef="Start_001B" targetRef="Task_001B_1" />
    <bpmn:sequenceFlow id="Flow_001B_2" sourceRef="Task_001B_1" targetRef="Task_001B_2" />
    <bpmn:sequenceFlow id="Flow_001B_3" sourceRef="Task_001B_2" targetRef="Gateway_001B_1" />
    <bpmn:sequenceFlow id="Flow_001B_4" sourceRef="Gateway_001B_1" targetRef="Task_001B_3" name="No" />
    <bpmn:sequenceFlow id="Flow_001B_5" sourceRef="Gateway_001B_1" targetRef="Task_001B_4" name="Yes" />
    <bpmn:sequenceFlow id="Flow_001B_6" sourceRef="Task_001B_3" targetRef="Task_001B_4" />
    <bpmn:sequenceFlow id="Flow_001B_7" sourceRef="Task_001B_4" targetRef="Task_001B_5" />
    <bpmn:sequenceFlow id="Flow_001B_8" sourceRef="Task_001B_5" targetRef="Task_001B_6" />
    <bpmn:sequenceFlow id="Flow_001B_9" sourceRef="Task_001B_6" targetRef="End_001B" />
  </bpmn:process>
