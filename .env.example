# ==============================================================================
# Northstar Retail Group — Enterprise Retail Analytics Platform
# Local Environment Configuration Template (.env.example)
#
# INSTRUCTIONS:
# 1. Copy this file to '.env': cp .env.example .env
# 2. Populate placeholders with environment-specific local development values.
# 3. NEVER commit the actual '.env' file containing secrets to version control.
# ==============================================================================

# Application Environment Execution Mode
# Permitted values: development | staging | production
APP_ENV=development
APP_NAME=Northstar_Retail_Analytics
APP_VERSION=1.0.0

# Database Configuration (PostgreSQL 16+)
# Used by SQLAlchemy, Psycopg, and dbt Core
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=northstar_analytics_dev
POSTGRES_USER=northstar_dev_user
POSTGRES_PASSWORD=placeholder_dev_password_change_me
POSTGRES_SCHEMA=public
POSTGRES_SSLMODE=prefer

# Local Data Storage Directories
DATA_RAW_DIR=./data/raw
DATA_BRONZE_DIR=./data/bronze
DATA_SILVER_DIR=./data/silver
DATA_GOLD_DIR=./data/gold
DATA_REFERENCE_DIR=./data/reference

# Operational Logging Configuration
LOG_LEVEL=INFO
LOG_DIR=./logs
LOG_FILE_NAME=northstar_pipeline.log
LOG_ROTATION_BYTES=10485760
LOG_BACKUP_COUNT=5

# Cryptographic Pseudonymization Architecture (Provisional BDL-05, FR-014)
# In production, this pepper is retrieved from an isolated KMS / HSM enclave
HMAC_PEPPER_SECRET=placeholder_64_character_hex_pepper_key_for_dev_only

# Operational Discrepancy Thresholds (Configurable Parameter per BDL-06)
# Default threshold for automated reconciliation exception ticketing in INR (₹)
PARAM_DISCREPANCY_THRESHOLD=500

# Pipeline Execution Cadence (Overnight T+1 Batch per BDL-01)
PIPELINE_TIMEZONE=Asia/Kolkata
BATCH_START_TIME_IST=01:00
DSR_DELIVERY_TIME_IST=06:00
